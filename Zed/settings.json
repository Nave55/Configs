// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "format_on_save": "on",
  "disable_ai": true,
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "copilot",
  },
  "auto_update": true,
  "auto_update_extensions": {
    "v": false,
  },
  "enable_language_server": true,
  "tasks": {
    "prefer_lsp": true,
  },
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  "tab_size": 2,
  "languages": {
    "V": {
      "enable_language_server": true,
      "tab_size": 4,
      "tasks": {
        "enabled": true,
        "prefer_lsp": true,
      },
      "use_on_type_format": true,
    },
    "Rust": {
      "tab_size": 4,
    },
    "Odin": {
      "inlay_hints": {
        "enabled": true
      },
      "tab_size": 4,
      "formatter": {
        "external": {
          "command": "odinfmt",
          "arguments": ["-stdin"]
        }
      },
    },
    "C++": {
      "format_on_save": "on",
      "tab_size": 2,
      "formatter": "language_server",
    },
  },
  "terminal": {
    "dock": "right",
    "cursor_shape": "bar",
    "blinking": "on",
  },
  "helix_mode": true,
  "vim_mode": false,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
  },
  "base_keymap": "VSCode",
  "minimap": {
    "show": "auto",
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "file_types": {
    "v": ["*.v"],
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Ayu Light",
    "dark": "Nave",
  },
  "lsp": {
    "ols": {
      "settings": {
        "path": "D:/Coding/Odin_Proj/ols/ols.exe",
      },
    },
  },
}
